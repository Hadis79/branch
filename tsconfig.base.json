{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "resolveJsonModule": true,
        "noImplicitAny": false,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@branch-services/client": ["libs/client/src/index.ts"],
            "@branch-services/components": ["libs/components/src/index.ts"],
            "@branch-services/hooks": ["libs/hooks/src/index.ts"],
            "@branch-services/layouts": ["libs/layouts/src/index.ts"],
            "@branch-services/services": ["libs/services/src/index.ts"],
            "@branch-services/translation": ["libs/translation/src/index.ts"],
            "@branch-services/types": ["libs/types/src/index.ts"],
            "@branch-services/ui-kit": ["libs/ui-kit/src/index.ts"],
            "@branch-services/utils": ["libs/utils/src/index.ts"],
            "@branch-services/workspace-plugin": [
                "tools/workspace-plugin/src/index.ts"
            ]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
